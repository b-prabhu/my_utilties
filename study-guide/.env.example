# Copy to .env and fill in. Lines are KEY=value.

PORT=3000
# Public URL used in emailed links (verification, password reset, invites).
APP_URL=http://localhost:3000

# The admin (teacher) account is created on first start.
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Teacher
# Leave blank to get a one-time "set your password" link printed in the server log.
ADMIN_PASSWORD=

# open = anyone can register with email confirmation; invite = admin invites only.
REGISTRATION=open
# Optional comma-separated list, e.g. school.ca,student.school.ca
ALLOWED_EMAIL_DOMAINS=
# Enrol new students in every subject automatically.
AUTO_ENROLL=true

# Email (SMTP). Without it, emails are kept in Admin -> Outbox instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# or a single URL, e.g. smtps://user:pass@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=Study Guide <no-reply@example.com>

# Optional AI marking of written answers against each question's rubric.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Set when running behind HTTPS / a reverse proxy.
TRUST_PROXY=false
COOKIE_SECURE=false
# Time zone for daily/weekly/monthly test periods.
TZ=America/Toronto
