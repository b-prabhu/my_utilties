{
  "name": "study-guide",
  "version": "1.0.0",
  "description": "Self-paced multi-subject study guide with subjective daily, weekly, monthly and on-demand tests",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "validate": "node scripts/validate-content.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "nodemailer": "^10.2.1"
  }
}
